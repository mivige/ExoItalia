---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/paths";
---

<Base
  title="Pagina non trovata — Exo Italia"
  description="La pagina che cerchi non esiste o è stata spostata."
>
  <Header />
  <main>
    <section>
      <div class="mx-auto max-w-page px-6 py-24 text-center md:py-32">
        <h1 class="text-h1 font-titoli font-semibold text-verde">Pagina non trovata</h1>
        <p class="mx-auto mt-4 max-w-prose text-body-lg">
          Il percorso che hai seguito si è interrotto qui. Torna alla home,
          o scrivici se pensi che manchi qualcosa.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href={withBase("/")} class="btn btn-primary">Torna alla home</a>
          <a href={withBase("/contatti")} class="btn btn-secondary">Contattaci</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
