---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getEntry } from "astro:content";

const site = (await getEntry("site", "site"))!.data;

// L'associazione non è iscritta al RUNTS: nessun obbligo di pubblicare
// statuto e bilanci. Resta la pubblicità dei contributi pubblici
// sopra i 10.000 € (L. 124/2017).

const contributi = [
  {
    anno: "2022", // anno del contributo; il progetto si è svolto nel 2023
    ente: "Regione Lazio",
    importo: "21.200 €",
    progetto:
      "Latina Innovation Community (progetto realizzato nel 2023) — bando Vitamina G, programma GenerAzioniGiovani.it (Politiche Giovanili della Regione Lazio, con il sostegno del Dipartimento per la Gioventù), a favore di Associazione Giovanile Exo Latina (C.F. 91170700594), erogato da Regione Lazio (C.F. 80143490581).",
  },
];
---

<Base
  title="Trasparenza - Exo Latina"
  description="I contributi pubblici ricevuti da Exo Latina, pubblicati secondo la L. 124/2017, e come richiedere statuto e bilanci dell'associazione."
>
  <Header />
  <main>
    <section class="border-b border-pietra">
      <div class="mx-auto max-w-page px-6 py-16 md:py-24">
        <h1 class="text-h1 font-titoli font-semibold text-verde">Trasparenza</h1>
        <p class="mt-6 max-w-prose text-body-lg">
          Exo Latina riceve anche contributi pubblici. La legge 124/2017
          impone di darne pubblicità quando superano i 10.000 €: questa
          pagina raccoglie i contributi ricevuti.
        </p>
      </div>
    </section>

    <section class="border-b border-pietra bg-nebbia">
      <div class="mx-auto max-w-page px-6 py-16 md:py-24">
        <h2 class="font-titoli font-semibold text-verde">Statuto e bilanci</h2>
        <p class="mt-4 max-w-prose text-body">
          Exo Latina non è iscritta al Registro Unico Nazionale del Terzo
          Settore (RUNTS), quindi non ha l'obbligo di pubblicare statuto e
          bilanci. Se vuoi consultarli, scrivici a
          <a
            href={`mailto:${site.contatti.email}`}
            class="underline decoration-verde/40 underline-offset-4 hover:decoration-verde"
          >{site.contatti.email}</a>.
        </p>
      </div>
    </section>

    <section>
      <div class="mx-auto max-w-page px-6 py-16 md:py-24">
        <h2 class="font-titoli font-semibold text-verde">Contributi pubblici ricevuti</h2>
        <div class="mt-8 overflow-x-auto">
          <table class="w-full min-w-[40rem] border-collapse text-left text-body">
            <thead>
              <tr class="border-b border-pietra text-small text-verde/75">
                <th class="py-2 pr-4 font-medium">Anno</th>
                <th class="py-2 pr-4 font-medium">Ente</th>
                <th class="py-2 pr-4 font-medium">Importo</th>
                <th class="py-2 font-medium">Progetto</th>
              </tr>
            </thead>
            <tbody>
              {
                contributi.map((riga) => (
                  <tr class="border-b border-pietra align-top">
                    <td class="py-3 pr-4">{riga.anno ?? "TODO"}</td>
                    <td class="py-3 pr-4">{riga.ente}</td>
                    <td class="py-3 pr-4">{riga.importo}</td>
                    <td class="py-3 max-w-prose">{riga.progetto}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
