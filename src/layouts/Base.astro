---
import { getEntry } from "astro:content";
import Seo from "../components/Seo.astro";
import { withBase } from "../lib/paths";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

const site = (await getEntry("site", "site"))!.data;
// Solo nel build di produzione: `npm run dev` non deve sporcare le statistiche.
const analyticsToken = import.meta.env.PROD ? site.cloudflareAnalyticsToken : null;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <Seo title={title} description={description} ogImage={ogImage} />
    {
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
