---
import { getEntry } from "astro:content";
import { withBase } from "../lib/paths";

const site = (await getEntry("site", "site"))!.data;

// Sagoma dell'Italia (con Sicilia e Sardegna) proiettata da dati geografici
// reali (confine ISO, world.geo.json), non disegnata a mano: proiezione
// equirettangolare corretta per la latitudine media, scalata su un viewBox
// 382×460. I punti sono coordinate reali di città, scelte per rappresentare
// "ogni luogo" (non solo le grandi città) — tra queste Latina e Campobasso,
// le due sedi della rete Exo.
const punti = [
  { nome: "Torino", x: 30.5, y: 89.6 },
  { nome: "Venezia", x: 181.1, y: 73.4 },
  { nome: "Firenze", x: 146.6, y: 146.6 },
  { nome: "Latina", x: 200.3, y: 247.5 },
  { nome: "Bari", x: 329.4, y: 262.9 },
  { nome: "Potenza", x: 294.7, y: 283.7 },
  { nome: "Reggio Calabria", x: 289.6, y: 394.6 },
  { nome: "Cagliari", x: 76.8, y: 345.9 },
  { nome: "Campobasso", x: 257.4, y: 243.4 },
  { nome: "Alessandria", x: 60.7, y: 96.5 },
];
---

<section class="overflow-hidden bg-carta">
  <div class="mx-auto grid max-w-page gap-10 px-6 py-16 md:grid-cols-2 md:items-center md:py-24">
    <div class="order-2 mx-auto w-full max-w-xs md:order-1 md:mx-0" aria-hidden="true">
      <svg viewBox="0 0 382 460" class="w-full">
        <path
          class="fill-none stroke-pietra"
          stroke-width="1.6"
          stroke-linejoin="round"
          d="M183.1,15.2 L229.6,26.6 L226.1,48.2 L233.9,66.8 L208.0,60.4 L181.5,76.0 L183.3,97.7 L179.4,110.2 L190.0,132.5 L220.5,154.6 L236.9,190.8 L273.1,226.2 L298.6,225.9 L306.5,235.6 L297.4,244.3 L326.6,260.2 L350.5,273.4 L378.4,296.3 L381.7,304.5 L375.6,320.2 L357.6,299.7 L329.3,292.5 L315.6,320.8 L339.1,337.1 L335.3,359.9 L321.7,362.5 L304.3,400.1 L290.7,403.5 L290.9,390.1 L297.5,366.6 L304.6,357.2 L291.9,331.8 L281.9,309.7 L268.4,304.3 L258.8,285.4 L237.9,277.4 L223.8,259.8 L199.7,256.9 L174.3,237.2 L144.6,208.6 L122.4,183.4 L112.3,140.0 L96.1,135.0 L69.6,120.5 L54.6,126.4 L35.8,146.7 L22.3,150.0 L26.0,130.9 L8.4,125.4 L0.0,91.5 L11.3,78.1 L1.7,61.7 L3.0,49.3 L17.0,58.7 L32.7,56.6 L51.0,41.7 L56.6,48.7 L72.1,47.3 L79.2,29.6 L103.3,35.1 L117.6,27.7 L120.2,9.7 L139.9,16.0 L143.7,7.6 L175.8,0.0 Z"
        />
        <path
          class="fill-none stroke-pietra"
          stroke-width="1.6"
          stroke-linejoin="round"
          d="M285.4,389.4 L273.7,423.9 L278.6,437.5 L271.7,460.0 L246.8,443.5 L230.3,438.8 L184.9,416.5 L189.4,394.0 L227.5,398.0 L260.7,393.2 Z"
        />
        <path
          class="fill-none stroke-pietra"
          stroke-width="1.6"
          stroke-linejoin="round"
          d="M80.1,258.8 L99.6,289.9 L95.0,347.9 L80.2,345.1 L66.9,359.8 L54.6,348.2 L53.3,295.3 L45.9,270.2 L63.8,272.4 Z"
        />

        {
          punti.map((punto, i) => (
            <circle
              class="punto-luce"
              style={`--ritardo: ${(i * 0.18).toFixed(2)}s;`}
              cx={punto.x}
              cy={punto.y}
            >
              <title>{punto.nome}</title>
            </circle>
          ))
        }
      </svg>
    </div>

    <div class="order-1 md:order-2">
      <h1 class="text-display font-titoli font-semibold text-verde text-balance">
        {site.payoff}
      </h1>
      <p class="mt-6 max-w-prose text-body-lg">
        Un'Italia in cui l'innovazione illumina ogni luogo, fatta di
        territori che invitano a restare.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={withBase("/contatti")} class="btn btn-primary">Entra nella community</a>
        <a href={withBase("/chi-siamo")} class="btn btn-secondary">Scopri chi siamo</a>
      </div>
    </div>
  </div>
</section>
