---
import { getEntry } from "astro:content";
import { withBase } from "../lib/paths";

const site = (await getEntry("site", "site"))!.data;
const arco = "M 40 232 A 130 130 0 1 1 232 40";
---

<section class="overflow-hidden bg-carta">
  <div class="mx-auto grid max-w-page gap-10 px-6 py-16 md:grid-cols-2 md:items-center md:py-24">
    <div class="order-2 mx-auto w-full max-w-xs md:order-1 md:mx-0" aria-hidden="true">
      <svg viewBox="0 0 272 272" class="w-full">
        <path
          d={arco}
          fill="none"
          stroke="var(--color-pietra)"
          stroke-width="2"
          stroke-linecap="round"
        />
        <circle class="arco-nodo" r="9" fill="var(--color-segnale)" style={`offset-path: path('${arco}');`} />
      </svg>
    </div>

    <div class="order-1 md:order-2">
      <h1 class="text-display font-titoli font-semibold text-verde text-balance">
        {site.payoff}
      </h1>
      <p class="mt-6 max-w-prose text-body-lg">
        Un'Italia in cui l'innovazione illumina ogni luogo, fatta di
        territori che invitano a restare.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={withBase("/contatti")} class="btn btn-primary">Entra nella community</a>
        <a href={withBase("/chi-siamo")} class="btn btn-secondary">Scopri chi siamo</a>
      </div>
    </div>
  </div>
</section>
