---
import { getCollection, getEntry } from "astro:content";

const site = (await getEntry("site", "site"))!.data;
const haNews = (await getCollection("news", (entry) => !entry.data.bozza)).length > 0;

const voci = [
  { href: "/chi-siamo", etichetta: "Chi siamo" },
  { href: "/attivita", etichetta: "Attività" },
  { href: "/sedi", etichetta: "Sedi" },
  ...(haNews ? [{ href: "/news", etichetta: "News" }] : []),
  { href: "/trasparenza", etichetta: "Trasparenza" },
  { href: "/contatti", etichetta: "Contatti" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="border-b border-pietra bg-carta">
  <div class="mx-auto flex max-w-page flex-wrap items-center justify-between gap-x-4 px-6 py-4">
    <a href="/" class="flex items-center gap-3">
      <img src="/images/logo_exo.png" alt={site.nome} class="h-10 w-10" width="40" height="40" />
      <span class="text-h3 font-titoli font-semibold">{site.nome}</span>
    </a>

    <input type="checkbox" id="menu-toggle" class="peer sr-only" />
    <label
      for="menu-toggle"
      class="ml-auto grid h-11 w-11 cursor-pointer list-none content-center justify-items-center gap-1.5 rounded-card p-2 peer-focus-visible:outline peer-focus-visible:outline-3 peer-focus-visible:outline-verde peer-focus-visible:outline-offset-2 md:hidden"
    >
      <span class="sr-only">Apri il menu</span>
      <span class="block h-0.5 w-6 bg-verde" aria-hidden="true"></span>
      <span class="block h-0.5 w-6 bg-verde" aria-hidden="true"></span>
      <span class="block h-0.5 w-6 bg-verde" aria-hidden="true"></span>
    </label>

    <nav aria-label="Principale" class="hidden w-full peer-checked:block md:block md:w-auto">
      <ul class="mt-4 flex flex-col gap-4 md:mt-0 md:flex-row md:items-center md:gap-8">
        {
          voci.map((voce) => (
            <li>
              <a
                href={voce.href}
                aria-current={isActive(voce.href) ? "page" : undefined}
                class="inline-block min-h-11 py-2 text-body font-medium text-verde underline decoration-transparent decoration-2 underline-offset-4 hover:decoration-verde aria-[current=page]:decoration-verde"
              >
                {voce.etichetta}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
