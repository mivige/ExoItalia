---
import type { CollectionEntry } from "astro:content";
import Placeholder from "./Placeholder.astro";
import { withBase } from "../lib/paths";

interface Props {
  sede: CollectionEntry<"sedi">;
  headingLevel?: "h2" | "h3";
}

const { sede, headingLevel = "h3" } = Astro.props;
const { nome, citta, claim, sommario, stato, copertina, copertinaAlt, esterno } = sede.data;
const Heading = headingLevel;
const href = esterno ?? withBase(`/sedi/${sede.id}`);
---

<a
  href={href}
  target={esterno ? "_blank" : undefined}
  rel={esterno ? "noopener noreferrer" : undefined}
  class="grid overflow-hidden rounded-card border border-pietra sm:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)]"
>
  <div class="bg-nebbia">
    {
      copertina ? (
        <img src={withBase(copertina)} alt={copertinaAlt} class="h-full w-full object-cover" />
      ) : (
        <Placeholder ratio="4/3" label={`${nome} — copertina`} />
      )
    }
  </div>
  <div class="flex flex-col justify-center gap-2 p-6">
    {
      stato === "in-avvio" && (
        <span class="inline-flex w-fit items-center rounded-card bg-verde px-2.5 py-1 text-small font-medium text-segnale">
          In avvio
        </span>
      )
    }
    <Heading class="text-h3 font-titoli font-semibold text-verde">{nome}</Heading>
    <p class="text-small text-verde/75">{citta}</p>
    <p class="text-body-lg italic text-verde/80">{claim}</p>
    <p class="text-body">{sommario}</p>
  </div>
</a>
